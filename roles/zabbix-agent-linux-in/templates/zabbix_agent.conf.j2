# ====================================================================================
# ZABBIX AGENT CONFIGURATION
# Managed by Ansible
# roles/zabbix-agent-linux-in/templates/zabbix_agent.conf.j2
# ====================================================================================

PidFile=/run/zabbix/{{ zabbix_agent_service }}.pid

LogFile=/var/log/zabbix/{{ zabbix_agent_service }}.log

LogFileSize={{ zabbix_agent_log_file_size }}

Server={{ zabbix_agent_server }}

ServerActive={{ zabbix_agent_server_active }}

Hostname={{ zabbix_agent_hostname }}

Timeout={{ zabbix_agent_timeout }}

{% if zabbix_agent_include_path | length > 0 %}
Include={{ zabbix_agent_include_path }}
{% endif %}