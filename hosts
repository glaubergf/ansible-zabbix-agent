# ===============================================================
# INVENTÁRIO DE HOSTS E GRUPOS
# hosts.yml
# ===============================================================

####################
# HOSTS
####################

# Debian Stable (VM KVM)
[debian_zabbix_agent]
kvm-debian ansible_host="{{ kvm_debian_public_ip }}"

# OpenSUSE Leap (VM KVM)
[opensuse_zabbix_agent]
kvm-opensuse ansible_host="{{ kvm_opensuse_public_ip }}"

# Rocky 9 (VM KVM)
[rocky_zabbix_agent]
kvm-rocky ansible_host="{{ kvm_rocky_public_ip }}"

# Zorin OS 18 (VM KVM)
[zorin_zabbix_agent]
kvm-zorin ansible_host="{{ kvm_zorin_public_ip }}"

####################
# VARIÁVEIS DE HOSTS
####################

# Debian Stable (VM KVM)
[debian_zabbix_agent:vars]
ansible_user = "{{ kvm_debian_ansible_user }}" 
ansible_password = "{{ kvm_debian_ansible_password }}"
ansible_become_password = "{{ kvm_debian_ansible_become_password }}"

# OpenSUSE Leap (VM KVM)
[opensuse_zabbix_agent:vars]
ansible_user = "{{ kvm_opensuse_ansible_user }}" 
ansible_password = "{{ kvm_opensuse_ansible_password }}"
ansible_become_password = "{{ kvm_opensuse_ansible_become_password }}"

# Rocky 9 (VM KVM)
[rocky_zabbix_agent:vars]
ansible_user = "{{ kvm_rocky_ansible_user }}" 
ansible_password = "{{ kvm_rocky_ansible_password }}"
ansible_become_password = "{{ kvm_rocky_ansible_become_password }}"

# Zorin OS 18 (VM KVM)
[zorin_zabbix_agent:vars]
ansible_user = "{{ kvm_zorin_ansible_user }}" 
ansible_password = "{{ kvm_zorin_ansible_password }}"
ansible_become_password = "{{ kvm_zorin_ansible_become_password }}"